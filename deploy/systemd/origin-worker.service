[Unit]
Description=Origin durable task worker
After=network.target origin-web.service

[Service]
Type=simple
WorkingDirectory=/opt/origin
Environment=NODE_ENV=production
Environment=ORIGIN_PROCESS_ROLE=worker
Environment=ORIGIN_BATCH_RECOVERY_ENABLED=1
Environment=ORIGIN_REAP_ORPHANS_ON_START=0
Environment=ORIGIN_INLINE_ONLINE_EDITOR_DOWNLOAD=1
EnvironmentFile=-/etc/origin/origin.env
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=5
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
