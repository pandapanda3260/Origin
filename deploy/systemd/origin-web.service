[Unit]
Description=Origin Web/API service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/origin
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=ORIGIN_PROCESS_ROLE=web
Environment=ORIGIN_BATCH_INLINE_RUNNER=0
Environment=ORIGIN_INLINE_ONLINE_EDITOR_DOWNLOAD=0
Environment=ORIGIN_REAP_ORPHANS_ON_START=0
Environment=ORIGIN_EXPECT_WORKER=1
EnvironmentFile=-/etc/origin/origin.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
