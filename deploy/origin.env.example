# Copy to /etc/origin/origin.env or your PM2/Docker environment.
# Keep this file secret once real values are filled.

NODE_ENV=production
PORT=3000

# Persistent volume. Do not point production at the release directory.
ORIGIN_DATA_DIR=/var/lib/origin/data
DB_PATH=/var/lib/origin/data/qd.sqlite
ORIGIN_OBJECT_STORAGE_DRIVER=local

# Web service should not own long-running jobs in production.
ORIGIN_BATCH_INLINE_RUNNER=0
ORIGIN_INLINE_ONLINE_EDITOR_DOWNLOAD=0
ORIGIN_REAP_ORPHANS_ON_START=0
ORIGIN_EXPECT_WORKER=1

# Worker service owns recovery and pending downloads.
ORIGIN_BATCH_RECOVERY_ENABLED=1
ORIGIN_BATCH_RECOVERY_INTERVAL_MS=10000
ORIGIN_ONLINE_EDITOR_DOWNLOAD_WORKER_INTERVAL_MS=10000
ORIGIN_ONLINE_EDITOR_DOWNLOAD_NEAR_EXPIRY_MS=1800000
ORIGIN_ONLINE_EDITOR_DOWNLOAD_MAX_ATTEMPTS=5
ORIGIN_ONLINE_EDITOR_DOWNLOAD_RETRY_BASE_MS=30000
ORIGIN_ONLINE_EDITOR_DOWNLOAD_MAX_BYTES=2147483648
ORIGIN_ONLINE_EDITOR_DOWNLOAD_TIMEOUT_MS=300000
ORIGIN_ALLOW_INSECURE_DOWNLOAD=0
ORIGIN_VIDEO_RECOVERY_INTERVAL_MS=30000
ORIGIN_DEFER_SEEDANCE_PROVIDER_POLLING=1
ORIGIN_PROVIDER_POLLING_INTERVAL_MS=10000
ORIGIN_PROVIDER_POLLING_LIMIT=10
ORIGIN_DISK_WARN_FREE_PCT=20
ORIGIN_DISK_WARN_FREE_BYTES=10737418240
ORIGIN_DISK_FAIL_FREE_PCT=10
ORIGIN_DISK_FAIL_FREE_BYTES=5368709120
ORIGIN_SQLITE_BACKUP_DIR=/var/lib/origin/backups
ORIGIN_SQLITE_BACKUP_RETAIN=14
ORIGIN_SQLITE_STRESS_DURATION_MS=86400000
ORIGIN_SQLITE_STRESS_MAX_BUSY_RATE=0.001
ORIGIN_SQLITE_STRESS_MAX_P99_MS=200

# Optional runtime tuning introduced after the production baseline.
RELAX_VIDEO_PROMPT_BLOCKERS=1
VIDEO_PROMPT_NETWORK_MAX_ATTEMPTS=4
VIDEO_PROMPT_RETRY_DEADLINE_MS=600000
VIDEO_PROMPT_REAPER_ENABLED=1
VIDEO_PROMPT_REAPER_TIMEOUT_MS=900000
VIDEO_PROMPT_REAPER_INTERVAL_MS=300000
VIDEO_PROMPT_BATCH_MISSING_TIMEOUT_MS=3600000
IMAGE_TIMEOUT_SECONDS=600
IMAGE_FALLBACK_ENABLED=false
IMAGE_GEN_RETRY_DEADLINE_MS=600000
IMAGE_GEN_TRANSIENT_MAX_ATTEMPTS=3
IMAGE_GEN_NETWORK_MAX_ATTEMPTS=3
IMAGE_GEN_429_MAX_ATTEMPTS=3
IMAGE_SUBMIT_CONCURRENCY=1
IMAGE_GEN_SUBMIT_CONCURRENCY=1
IMAGE_THUMB_ENABLED=1
IMAGE_THUMB_CONCURRENCY=
IMAGE_THUMB_ACTIVE_VERSIONS=v1
IMAGE_THUMB_MAX_AGE_DAYS=90
IMAGE_THUMB_CACHE_MAX_BYTES=21474836480
IMAGE_THUMB_TMP_MAX_HOURS=6
IMAGE_QUALITY_STRICT=0
IMAGE_CHARACTER_FALLBACK_ENABLED=0
IMAGE_CHARACTER_PRIMARY_RETRY_ATTEMPTS=3
LLM_BACKGROUND_SUBMIT_TIMEOUT_MS=300000
LLM_BACKGROUND_POLL_INTERVAL_MS=5000
LLM_BACKGROUND_POLL_TIMEOUT_MS=30000
PROXY_STATUSTEXT_SANITIZE_ENABLED=true

# Security.
JWT_SECRET=replace-with-at-least-32-random-bytes
ORIGIN_HEALTH_EXPOSE_DETAILS=0
ORIGIN_HEALTH_NEEDS_REVIEW_THRESHOLD=20
ORIGIN_REQUIRE_VEVDEMO_HMAC=1
VEVDEMO_CALLBACK_SECRET=
VEVDEMO_CALLBACK_SECRET_PREV=

# VevDemo / Volcengine. Secrets stay backend-only.
ONLINE_EDITOR_ENABLED=0
ONLINE_EDITOR_OPEN_MODE=iframe

# Recommended VevDemo endpoint names.
VEVDEMO_EDITOR_URL=
VEVDEMO_API_URL=
VEVDEMO_EDITOR_PROJECT_URL=

# Deprecated compatibility keys. Prefer the names above for new deployments.
VEVDEMO_FRONTEND_URL=
VEVDEMO_BACKEND_URL=
VEVDEMO_IFRAME_PROJECT_URL=

# VevDemo runtime credentials and editor config (required when ONLINE_EDITOR_ENABLED=1).
VITE_VEV_PROJECT_ID=
VITE_VEV_GROUP_ID=
VITE_VEV_REGION=
VITE_VEV_DEFAULT_CLASSIFICATION_ID=
VITE_VEV_UPLOAD_APP_ID=
# Optional VOD upload workflow TemplateId for new video uploads.
# Configure a H.264/AAC workflow in Volcengine VOD first; historical HEVC videos
# must be re-uploaded or reprocessed separately.
# VOD Space must also have a valid playback domain; otherwise GetPlayInfo returns
# ResourceNotFound.NoAvailableDomain and videos remain non-draggable.
VITE_VEV_UPLOAD_WORKFLOW_TEMPLATE_ID=
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
