# ============================================================================
# Origin 侧配置（写入 /Users/mark/Documents/key/origin.env.local）
# ============================================================================
ONLINE_EDITOR_ENABLED=true
ONLINE_EDITOR_OPEN_MODE=iframe

# Origin iframe 加载 VevDemo Editor，Origin API 代理访问 VevDemo API。
VEVDEMO_EDITOR_URL=http://127.0.0.1:8084
VEVDEMO_API_URL=http://127.0.0.1:3002
VEVDEMO_BACKEND_PORT=3002

# 火山引擎访问凭证也放在这一份外部文件，VevDemo 后端通过 shell source 注入。
VOLC_ACCESS_KEY=your_access_key_here
VOLC_SECRET_KEY=your_secret_key_here

# ============================================================================
# VevDemo 前端公开配置
# ============================================================================
# 运行 npm run sync:vevdemo-env 后，这些 VITE_* 会被同步到：
# /Users/mark/Documents/origin/vevdemo-1.0.6/fe/.env.local
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=8084
VITE_VEVDEMO_API_BASE=http://127.0.0.1:3002
VITE_VEV_REGION=cn-north-1
VITE_VEV_PROJECT_ID=your_project_id
VITE_VEV_GROUP_ID=your_group_id
VITE_VEV_DEFAULT_CLASSIFICATION_ID=
VITE_VEV_VOD_ACCOUNT_ID=
VITE_VEV_UPLOAD_APP_ID=
VITE_VEV_VOD_HOST=https://vod.volcengineapi.com

# 可选但对 MP4 可拖入时间线非常关键：
# 在火山 VOD 控制台创建输出 H.264/AAC 的工作流后，填写对应模板 ID。
# 当前本机已可使用预设「在线视频多码率（含265）」：06853553c4d3402698a17ff5dff87fd7
# 只影响后续新上传素材；历史 HEVC 素材需要重传或单独重跑 VOD 工作流。
VITE_VEV_UPLOAD_WORKFLOW_TEMPLATE_ID=

# 兼容旧名：已有部署仍可继续使用，新的配置请优先使用 VEVDEMO_EDITOR_URL / VEVDEMO_API_URL。
VEVDEMO_FRONTEND_URL=
VEVDEMO_BACKEND_URL=
VEVDEMO_IFRAME_PROJECT_URL=
